# Copy to .env — read by the api container (docker-compose env_file).

ENV=dev

# Random string used to sign the OAuth state cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Where the web app is served. OAuth redirects back here.
WEB_URL=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared read-only demo project (seeded on startup)
DEMO_ENABLED=true
DEMO_LIVE=true
